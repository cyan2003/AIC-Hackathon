# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Embedding Configuration
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true

# Chunking Configuration
CHUNKING_STRATEGY=fixed_size
CHUNKING_CHUNK_SIZE=512
CHUNKING_CHUNK_OVERLAP=64
CHUNKING_MIN_CHUNK_SIZE=50

# Vector Store Configuration
VECTOR_STORE_BACKEND=qdrant
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=6333
VECTOR_STORE_GRPC_PORT=6334
VECTOR_STORE_PREFER_GRPC=true
VECTOR_STORE_TIMEOUT=30.0

# Lexical Search Configuration
LEXICAL_STORE_BACKEND=bm25
LEXICAL_STORE_K1=1.5
LEXICAL_STORE_B=0.75

# Fusion & Reranking Configuration
FUSION_STRATEGY=reciprocal_rank
FUSION_RRF_K=60
FUSION_VECTOR_WEIGHT=0.6
FUSION_LEXICAL_WEIGHT=0.4
FUSION_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
FUSION_RERANKER_TOP_K=50

# LLM Candidate Assessment Agent (Chutes AI)
CHUTES_API_KEY=your_chutes_api_key_here
AGENT_MODEL=deepseek-ai/DeepSeek-R1-0528
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=4096

# Cache Configuration
CACHE_ENABLE_LLM_CACHE=true
CACHE_ENABLE_EMBEDDING_CACHE=true
CACHE_DB_PATH=data/cache.db
